{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/movie/:id/:slug", "destination": "/api/seo?type=movie&id=:id" },
    { "source": "/tv/:id/:slug", "destination": "/api/seo?type=tv&id=:id" },
    { "source": "/movie/:path*", "destination": "/" },
    { "source": "/tv/:path*", "destination": "/" },
    { "source": "/collection/:path*", "destination": "/" },
    { "source": "/movies", "destination": "/" },
    { "source": "/watchlist", "destination": "/" },
    { "source": "/kategori.php", "destination": "/kategori.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=() }
      ]
    },
    {
      "source": "/phase1-ux.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/phase2-ux.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/phase3-ux.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/mature-genre.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/new-features-carousel.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
